{
  "name": "harvest-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src e2e playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  }
}
